    "components": {
        "schemas": {
            "Address": {
                "required": [
                    "number",
                    "way_name",
                    "way_type",
                    "city",
                    "zip_code",
                    "country"
                ],
                "properties": {
                    "number": {
                        "description": "House or building number",
                        "type": "integer"
                    },
                    "number_complement": {
                        "description": "Additional address information (optional)",
                        "type": "string"
                    },
                    "way_name": {
                        "description": "Street name",
                        "type": "string"
                    },
                    "way_type": {
                        "description": "Type of street (e.g., Street, Avenue)",
                        "type": "string"
                    },
                    "city": {
                        "description": "City name",
                        "type": "string"
                    },
                    "zip_code": {
                        "description": "Postal code",
                        "type": "string"
                    },
                    "country": {
                        "description": "Country name",
                        "type": "string"
                    },
                    "latitude": {
                        "description": "Latitude coordinate (optional)",
                        "type": "string"
                    },
                    "longitude": {
                        "description": "Longitude coordinate (optional)",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "Company": {
                "required": [
                    "name",
                    "email"
                ],
                "properties": {
                    "name": {
                        "description": "Company name",
                        "type": "string"
                    },
                    "email": {
                        "description": "Company email",
                        "type": "string",
                        "format": "email"
                    },
                    "phone": {
                        "description": "Company phone number (optional)",
                        "type": "string"
                    },
                    "billing_address_id": {
                        "description": "Billing address ID (optional)",
                        "type": "integer"
                    },
                    "shipping_address_id": {
                        "description": "Shipping address ID (optional)",
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "Customer": {
                "required": [
                    "username",
                    "last_name",
                    "first_name",
                    "email"
                ],
                "properties": {
                    "username": {
                        "description": "Customer username",
                        "type": "string"
                    },
                    "last_name": {
                        "description": "Customer last name",
                        "type": "string"
                    },
                    "first_name": {
                        "description": "Customers first name",
                        "type": "string"
                    },
                    "email": {
                        "description": "Customer email",
                        "type": "string",
                        "format": "email"
                    },
                    "phone": {
                        "description": "Customer phone number (optional)",
                        "type": "string"
                    },
                    "is_active": {
                        "description": "Is the customer active? (optional)",
                        "type": "boolean"
                    },
                    "company_id": {
                        "description": "Company ID (optional, must exist in companies table)",
                        "type": "integer"
                    }
                },
                "type": "object"
            }
        }
